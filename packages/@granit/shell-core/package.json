    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/idempotency": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "zustand": "^5.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/idempotency": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.6.0",
    "zustand": "^5.0.14"
  }
}
