{
  "name": "@granit/react-ai-prompts",
  "description": "Headless React bindings for @granit/ai-prompts — AIPromptsProvider, prompt catalogue CRUD + customise hooks, the / picker hook, query-key factory, the framework-agnostic PromptIcon glyph renderer + registry, and the i18n bundles. The styled catalogue / form / picker UI lives in @granit/react-ui-ai-prompts.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/ai-prompts": "workspace:*",
    "@granit/api-client": "workspace:*",
    "@granit/logger": "workspace:*",
    "@granit/react-api-client": "workspace:*",
    "@granit/react-icons": "workspace:*",
    "@granit/types": "workspace:*",
    "@granit/utils": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": "^1.23.0",
    "msw": "^2.14.6",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/ai-prompts": "workspace:*",
    "@granit/api-client": "workspace:*",
    "@granit/logger": "workspace:*",
    "@granit/react-api-client": "workspace:*",
    "@granit/react-icons": "workspace:*",
    "@granit/react-testing": "workspace:*",
    "@granit/testing": "workspace:*",
    "@granit/types": "workspace:*",
    "@granit/utils": "workspace:*"
  }
}
