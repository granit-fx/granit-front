{
  "name": "@granit/react-ui-cms-releases",
  "description": "Granit admin UI for the CMS Releases module — the releases list, release detail with scheduling/cancel, status badges and the create-release dialog. Composes @granit/react-cms (headless) with the foundation UI packages.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/cms": "workspace:*",
    "@granit/react-cms": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/cms": "workspace:*",
    "@granit/react-cms": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@granit/testing": "workspace:*",
    "@granit/types": "workspace:*",
    "@storybook/react-vite": "^10.4.6",
    "@tanstack/react-query": "^5.101.2",
    "storybook": "^10.4.6"
  }
}
