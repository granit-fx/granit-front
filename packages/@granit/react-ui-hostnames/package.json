{
  "name": "@granit/react-ui-hostnames",
  "description": "Granit admin UI for the managed Hostnames module — owner-scoped hostname list, DNS details, status/certificate badges, row actions and add-hostname dialog. Composes @granit/react-hostnames (headless) with the foundation UI packages.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/hostnames": "workspace:*",
    "@granit/react-authorization": "workspace:*",
    "@granit/react-hostnames": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/hostnames": "workspace:*",
    "@granit/react-authorization": "workspace:*",
    "@granit/react-hostnames": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@storybook/react-vite": "^10.5.0",
    "@tanstack/react-query": "^5.0.0",
    "storybook": "^10.5.0"
  }
}
