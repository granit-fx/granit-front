{
  "name": "@granit/react-ui-cms-hostnames",
  "description": "Granit admin UI for the CMS site-scoped Hostnames module — the per-site hostname list, add-hostname form (spec-driven validation), status badge, verify and remove actions. Composes @granit/react-cms-hostnames (headless) with the foundation UI packages.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/cms-hostnames": "workspace:*",
    "@granit/react-cms-hostnames": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@granit/utils": "workspace:*",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.3.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/cms-hostnames": "workspace:*",
    "@granit/react-cms-hostnames": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@granit/testing": "workspace:*",
    "@granit/types": "workspace:*",
    "@granit/utils": "workspace:*",
    "@storybook/react-vite": "^10.5.10",
    "@tanstack/react-query": "^5.0.0",
    "storybook": "^10.5.10"
  }
}
