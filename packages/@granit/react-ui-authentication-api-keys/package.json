{
  "name": "@granit/react-ui-authentication-api-keys",
  "description": "Granit admin UI for the Authentication API keys module — the api-key list (search, type/environment filters, revoke + rotate), the spec-validated create form, and the detail page (scopes editing). Composes the headless @granit/react-authentication-api-keys with the foundation UI packages.",
  "version": "0.1.0",
  "license": "Apache-2.0",
