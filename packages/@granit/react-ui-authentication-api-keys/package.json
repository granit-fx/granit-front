  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/authentication-api-keys": "workspace:*",
    "@granit/query-engine": "workspace:*",
    "@granit/react-authentication-api-keys": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@granit/types": "workspace:*",
    "@granit/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.3.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
