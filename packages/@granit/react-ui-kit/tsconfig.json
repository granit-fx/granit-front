{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Tests and stories are part of this package's `include`, so the ambient
    // globals vitest injects (`globals: true`) and the jest-dom matchers pulled
    // in by `@granit/testing`'s setup file have to be declared here.
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
