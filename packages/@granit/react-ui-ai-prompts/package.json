{
  "name": "@granit/react-ui-ai-prompts",
  "description": "Granit admin UI for the AI Prompts module — the styled catalogue list, the spec-driven create/edit prompt form, the icon picker, the / prompt picker, and the catalogue management page (create-and-edit dialog form plus a delete confirmation). Composes @granit/react-ai-prompts (headless) with the foundation UI packages, derives form validation from the OpenAPI contract via @granit/react-validation, and gates management actions with @granit/react-authorization.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/ai-prompts": "workspace:*",
    "@granit/react-ai-prompts": "workspace:*",
    "@granit/react-authorization": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/react-validation": "workspace:*",
    "@granit/utils": "workspace:*",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
