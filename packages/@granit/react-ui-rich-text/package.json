    "@tiptap/extension-text-align": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/suggestion": "^3.29.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
