{
  "name": "@granit/react-ui-localization",
  "description": "Granit admin UI for the Localization module — the available-languages list (read-only, sourced from the LanguagesContext) and the translation-overrides grid (query-driven table with module/culture badges, create/edit/delete dialogs and data-exchange import/export). Composes @granit/react-localization (headless) with the foundation UI packages.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/localization": "workspace:*",
    "@granit/logger": "workspace:*",
    "@granit/query-engine": "workspace:*",
    "@granit/react-api-client": "workspace:*",
    "@granit/react-data-exchange": "workspace:*",
    "@granit/react-localization": "workspace:*",
    "@granit/react-query-engine": "workspace:*",
    "@granit/react-ui": "workspace:*",
    "@granit/react-ui-data-exchange": "workspace:*",
    "@granit/react-ui-kit": "workspace:*",
    "@granit/utils": "workspace:*",
    "@tanstack/react-table": "^9.0.0",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
