{
  "name": "@granit/testing",
  "description": "Shared test utilities for @granit/* packages — mock clients, mock loggers, Axios response helpers",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./msw": "./src/msw.ts",
    "./setup": "./src/setup.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/logger": "workspace:*",
    "msw": "^2.12.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@granit/logger": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./msw": {
        "types": "./dist/msw.d.ts",
        "import": "./dist/msw.js"
      },
      "./setup": {
        "types": "./dist/setup.d.ts",
        "import": "./dist/setup.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@granit/api-client": "workspace:*",
    "@granit/logger": "workspace:*"
  }
}
