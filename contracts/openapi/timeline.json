  "components": {
    "schemas": {
      "AnchorTimelineEntryRequest": {
        "required": ["sourceKey", "sourceId"],
        "type": "object",
        "properties": {
          "sourceKey": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          }
        }
      },
      "AnchorTimelineEntryResponse": {
        "required": ["entryId"],
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "type": ["null", "integer"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PagedResultOfTimelineStreamEntryResponse": {
        "required": ["items", "totalCount", "hasMore"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineStreamEntryResponse"
            }
          },
          "totalCount": {
            "type": ["null", "integer"],
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": ["null", "string"]
          }
        }
      },
      "PostTimelineEntryRequest": {
        "required": ["entryType", "body"],
        "type": "object",
        "properties": {
          "entryType": {
            "$ref": "#/components/schemas/TimelineEntryType"
          },
          "body": {
            "type": "string"
          },
          "parentEntryId": {
            "type": ["null", "string"],
            "format": "uuid"
          },
          "attachmentBlobIds": {
            "type": ["null", "array"],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type."
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence."
          }
        }
      },
      "ReactionAggregateResponse": {
        "required": ["count", "byCurrentUser", "displayEmoji"],
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "byCurrentUser": {
            "type": "boolean"
          },
          "displayEmoji": {
            "type": "string"
          }
        }
      },
      "ReactionToggleResponse": {
        "required": ["entryId", "emoji", "count", "currentUserHasReacted"],
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "emoji": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "currentUserHasReacted": {
            "type": "boolean"
          }
        }
      },
      "TimelineAttachmentInfoResponse": {
        "required": ["id", "blobId", "fileName", "contentType", "sizeBytes"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "blobId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int64"
          }
        }
      },
      "TimelineEntryType": {
        "enum": ["Comment", "SystemLog", "InternalNote"]
      },
      "TimelineStreamEntryResponse": {
        "required": [
          "id",
          "occurredAt",
          "entryType",
          "authorId",
          "authorName",
          "body",
          "attachments",
          "parentEntryId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "entryType": {
            "$ref": "#/components/schemas/TimelineStreamEntryType"
          },
          "authorId": {
            "type": ["null", "string"]
          },
          "authorName": {
            "type": ["null", "string"]
          },
