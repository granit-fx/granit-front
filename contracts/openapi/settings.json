  "components": {
    "schemas": {
      "AdminAppSettingResponse": {
        "required": [
          "key",
          "label",
          "description",
          "defaultValue",
          "value",
          "valueKind",
          "allowedValues",
          "isEncrypted"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": ["null", "string"]
          },
          "description": {
            "type": ["null", "string"]
          },
          "defaultValue": {
            "type": ["null", "string"]
          },
          "value": {
            "type": ["null", "string"]
          },
          "valueKind": {
            "$ref": "#/components/schemas/ValueKind"
          },
          "allowedValues": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "isEncrypted": {
            "type": "boolean"
          }
        }
      },
      "BulkSettingEntry": {
        "required": ["key", "value"],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": ["null", "string"]
          }
        }
      },
      "BulkSettingOutcome": {
        "enum": ["Updated", "NotFound", "ProviderNotAllowed", "ValidationFailed"]
      },
      "BulkSettingResult": {
        "required": ["key", "outcome", "errorCode"],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/BulkSettingOutcome"
          },
          "errorCode": {
            "type": ["null", "string"]
          }
        }
      },
      "BulkUpdateSettingsRequest": {
        "required": ["settings"],
        "type": "object",
        "properties": {
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkSettingEntry"
            },
            "x-granit-validator": "Validation:BulkSettingsTooLarge"
          }
        }
      },
      "BulkUpdateSettingsResponse": {
        "required": ["results"],
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkSettingResult"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
