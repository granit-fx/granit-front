{
  "openapi": "3.1.1",
  "info": {
    "title": "cms-hostnames",
    "version": "1"
  },
  "paths": {
    "/api/cms/sites/{siteId}/hostnames": {
      "get": {
        "tags": ["CMS - Site Hostnames"],
        "summary": "Lists a site's hostnames.",
        "description": "Returns the managed hostnames registered for the site, with status, expected DNS records and certificate state.",
        "operationId": "ListCmsSiteHostnames",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "description": "Unique identifier of the site.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SiteHostnameResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["CMS - Site Hostnames"],
        "summary": "Registers a hostname for the site.",
        "description": "Registers a hostname (owner type cms.site) and starts DNS verification when the platform ingress target is configured. Returns the records the owner must configure.",
        "operationId": "CreateCmsSiteHostname",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "description": "Unique identifier of the site.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteHostnameCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteHostnameResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/cms/sites/{siteId}/hostnames/availability": {
      "get": {
        "tags": ["CMS - Site Hostnames"],
        "summary": "Checks whether a hostname can be registered.",
        "description": "Pre-check before registering: returns whether the host is free (hostnames are globally unique). A malformed FQDN returns 400.",
        "operationId": "CheckCmsSiteHostnameAvailability",
        "parameters": [
          {
            "name": "host",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteHostnameAvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/cms/sites/{siteId}/hostnames/{hostnameId}": {
      "delete": {
        "tags": ["CMS - Site Hostnames"],
        "summary": "Removes a hostname from the site.",
        "description": "Deletes the hostname, freeing it for re-registration. 404 when the hostname is not owned by this site.",
        "operationId": "DeleteCmsSiteHostname",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "description": "Unique identifier of the site.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "hostnameId",
            "in": "path",
            "description": "Unique identifier of the hostname.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/cms/sites/{siteId}/hostnames/{hostnameId}/verify-now": {
      "post": {
        "tags": ["CMS - Site Hostnames"],
        "summary": "Triggers DNS re-verification of a site hostname.",
        "description": "Initiates verification for a pending hostname, or resets backoff and re-queues a check for an active/errored one. 409 when pending and the platform ingress target is not configured.",
        "operationId": "VerifyCmsSiteHostname",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "description": "Unique identifier of the site.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "hostnameId",
            "in": "path",
            "description": "Unique identifier of the hostname.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteHostnameResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "type": ["null", "integer"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type."
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence."
          }
        }
      },
      "SiteHostnameAvailabilityResponse": {
        "required": ["host", "available"],
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        },
        "example": {
          "host": "blog.granit.example",
          "available": false
        }
      },
      "SiteHostnameCreateRequest": {
        "required": ["host"],
        "type": "object",
        "properties": {
          "host": {
            "maxLength": 253,
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean",
            "default": false
          }
        },
        "example": {
          "host": "www.granit.example",
          "isPrimary": true
        }
      },
      "SiteHostnameDnsRecordResponse": {
        "required": ["recordType", "name", "value"],
        "type": "object",
        "properties": {
          "recordType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "example": {
          "recordType": "Txt",
          "name": "_granit-challenge.www.granit.example",
          "value": "granit-verify=7f3a9c1e4b2d8f60"
        }
      },
      "SiteHostnameResponse": {
        "required": [
          "id",
          "host",
          "status",
          "isPrimary",
          "expectedDnsRecords",
          "lastCheckedAt",
          "certificateStatus"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "host": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          },
          "expectedDnsRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SiteHostnameDnsRecordResponse"
            }
          },
          "lastCheckedAt": {
            "type": ["null", "string"],
            "format": "date-time"
          },
          "certificateStatus": {
            "type": "string"
          }
        },
        "example": {
          "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "host": "www.granit.example",
          "status": "Active",
          "isPrimary": true,
          "expectedDnsRecords": [
            {
              "recordType": "Cname",
              "name": "www.granit.example",
              "value": "edge.granit.example"
            },
            {
              "recordType": "Txt",
              "name": "_granit-challenge.www.granit.example",
              "value": "granit-verify=7f3a9c1e4b2d8f60"
            }
          ],
          "lastCheckedAt": "2026-07-05T09:30:00+00:00",
          "certificateStatus": "Issued"
        }
      }
    }
  },
  "tags": [
    {
      "name": "CMS - Site Hostnames"
    }
  ]
}
