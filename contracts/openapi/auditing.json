  "components": {
    "schemas": {
      "AuditCategory": {
        "enum": [
          "DataMutation",
          "ConfigurationChange",
          "DataAccess",
          "AccessDenied",
          "PrivilegedAccess"
        ]
      },
      "AuditChangeType": {
        "enum": ["Created", "Modified", "Deleted", "SoftDeleted"]
      },
      "AuditEntityChangeResponse": {
        "required": ["entityType", "entityId", "changeType", "propertyChanges"],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "changeType": {
            "$ref": "#/components/schemas/AuditChangeType"
          },
          "propertyChanges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditPropertyChangeResponse"
            }
          }
        }
      },
      "AuditEntityChangeSummaryResponse": {
        "required": [
          "id",
          "auditEntryId",
          "entityType",
          "entityId",
          "changeType",
          "propertyChangeCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "auditEntryId": {
            "type": "string",
            "format": "uuid"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "changeType": {
            "$ref": "#/components/schemas/AuditChangeType"
          },
          "propertyChangeCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AuditEntryDetailResponse": {
        "required": [
          "id",
          "timestamp",
          "userId",
          "userName",
          "category",
          "ipAddress",
          "userAgent",
          "tenantId",
          "correlationId",
          "entityChanges"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": ["null", "string"]
          },
          "category": {
            "$ref": "#/components/schemas/AuditCategory"
          },
          "ipAddress": {
            "type": ["null", "string"]
          },
          "userAgent": {
            "type": ["null", "string"]
          },
          "tenantId": {
            "type": ["null", "string"],
            "format": "uuid"
          },
          "correlationId": {
            "type": ["null", "string"]
          },
          "entityChanges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntityChangeResponse"
            }
          }
        },
        "example": {
          "id": "b3f7a1c2-9d4e-4f8a-b6c5-1e2d3f4a5b6c",
          "timestamp": "2026-03-17T10:15:30+00:00",
          "userId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "userName": "Jane Doe",
          "category": "DataMutation",
          "ipAddress": "198.51.100.42",
          "tenantId": "d4e5f6a7-b8c9-0123-4567-89abcdef0123",
          "correlationId": "req-abc123def456",
          "entityChanges": [
            {
              "entityType": "Patient",
              "entityId": "42",
              "changeType": "Modified",
              "propertyChanges": [
                {
                  "propertyName": "Email",
                  "originalValue": "old@example.com",
                  "newValue": "new@example.com"
                }
              ]
            }
          ]
        }
      },
      "AuditEntryResponse": {
        "required": [
          "id",
          "timestamp",
          "userId",
          "userName",
          "category",
          "ipAddress",
          "tenantId",
          "correlationId",
          "entityChangeCount"
        ],
        "type": "object",
