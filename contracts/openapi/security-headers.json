{
  "openapi": "3.1.1",
  "info": {
    "title": "security-headers",
    "version": "1"
  },
  "paths": {
    "/security-headers/csp": {
      "get": {
        "tags": [
          "Security Headers"
        ],
        "summary": "Returns the effective Content-Security-Policy per endpoint.",
        "description": "Returns a snapshot of the composed CSP for every registered endpoint, plus the base directives and the list of registered ICspContributor implementations. Contributors that branch on request-scoped state beyond endpoint metadata (e.g. authenticated user, tenant) will under-report — the audit synthesises requests carrying only the matched endpoint.",
        "operationId": "GetCspAudit",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CspAuditResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CspAuditResponse": {
        "required": [
          "baseDirectives",
          "rawOverride",
          "reportOnly",
          "contributors",
          "endpoints"
        ],
        "type": "object",
        "properties": {
          "baseDirectives": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "rawOverride": {
            "type": [
              "null",
              "string"
            ]
          },
          "reportOnly": {
            "type": "boolean"
          },
          "contributors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CspContributorInfo"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CspEndpointAudit"
            }
          }
        }
      },
      "CspContributorInfo": {
        "required": [
          "name",
          "fullTypeName"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "fullTypeName": {
            "type": "string"
          }
        }
      },
      "CspEndpointAudit": {
        "required": [
          "httpMethods",
          "pattern",
          "displayName",
          "headerName",
          "composedCsp"
        ],
        "type": "object",
        "properties": {
          "httpMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          },
          "composedCsp": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type."
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Security Headers"
    }
  ]
}