            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "assignedToUserId": {
            "type": "string",
            "format": "uuid"
          },
          "createdByUserId": {
            "type": ["null", "string"],
            "format": "uuid"
          },
          "dueAt": {
