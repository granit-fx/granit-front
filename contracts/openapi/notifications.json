              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "NotificationDefinition": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "defaultSeverity": {
            "$ref": "#/components/schemas/NotificationSeverity"
          },
          "defaultChannels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "displayName": {
            "type": ["null", "string"]
          },
          "description": {
            "type": ["null", "string"]
          },
          "groupName": {
            "type": ["null", "string"]
          },
          "allowUserOptOut": {
            "type": "boolean"
          },
          "allowDoNotDisturbBypass": {
            "type": "boolean"
          },
          "requiredPermission": {
            "type": ["null", "string"]
          },
          "requiredFeature": {
            "type": ["null", "string"]
          }
        }
      },
      "NotificationPreferenceResponse": {
        "required": ["id", "userId", "notificationTypeName", "channelName", "isEnabled"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "notificationTypeName": {
            "type": "string"
          },
          "channelName": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "NotificationPreferenceUpdateRequest": {
        "required": ["notificationTypeName", "channelName", "isEnabled"],
        "type": "object",
        "properties": {
          "notificationTypeName": {
            "type": "string"
          },
          "channelName": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "NotificationSeverity": {
        "enum": ["Info", "Success", "Warning", "Error", "Fatal"]
      },
      "NotificationSubscriptionResponse": {
        "required": ["id", "userId", "notificationTypeName", "entityType", "entityId"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "notificationTypeName": {
            "type": "string"
          },
          "entityType": {
            "type": ["null", "string"]
          },
          "entityId": {
            "type": ["null", "string"]
          }
        }
      },
      "PagedResultOfUserNotificationResponse": {
        "required": ["items", "totalCount", "hasMore"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserNotificationResponse"
            }
          },
          "totalCount": {
            "type": ["null", "integer"],
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": ["null", "string"]
          }
