  "components": {
    "schemas": {
      "BatchPresenceRequest": {
        "required": [
          "userIds"
        ],
        "type": "object",
        "properties": {
          "userIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "BatchPresenceResponse": {
        "required": [
          "presences"
        ],
        "type": "object",
        "properties": {
          "presences": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/PresenceResponse"
            }
          }
        }
      },
      "HeartbeatRequest": {
        "required": [
          "idleSeconds"
        ],
        "type": "object",
        "properties": {
          "idleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HeartbeatRoomRequest": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ManualPresenceStatus": {
        "enum": [
          "Available",
          "Busy",
          "DoNotDisturb",
          "AppearOffline",
          null
        ]
      },
      "PresenceResponse": {
        "required": [
          "userId",
          "effectiveStatus",
          "manualOverride",
          "overrideUntilUtc",
          "lastSeenUtc"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveStatus": {
            "$ref": "#/components/schemas/PresenceStatus"
          },
          "manualOverride": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ManualPresenceStatus"
              }
            ]
          },
          "overrideUntilUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastSeenUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "PresenceStatus": {
        "enum": [
          "Online",
          "Away",
          "Offline",
          "Busy",
          "DoNotDisturb"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type."
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence."
          }
        }
      },
      "ResourcePresenceParticipantResponse": {
        "required": [
          "userId",
          "lastSeenUtc",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "lastSeenUtc": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResourceRoomResponse": {
        "required": [
          "kind",
          "id",
          "participants"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourcePresenceParticipantResponse"
            }
          }
        }
      },
      "SetPresenceRequest": {
        "required": [
          "manualStatus"
        ],
        "type": "object",
        "properties": {
          "manualStatus": {
            "$ref": "#/components/schemas/ManualPresenceStatus"
          },
          "untilUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Presence"
