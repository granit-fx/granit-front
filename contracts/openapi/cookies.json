{
  "openapi": "3.1.1",
  "info": {
    "title": "cookies",
    "version": "1"
  },
  "paths": {
    "/cookies/config": {
      "get": {
        "tags": ["Cookie Consent"],
        "summary": "Returns the cookie consent configuration for CMP setup.",
        "description": "Returns the full list of internal cookies and third-party services registered in the application, categorized for GDPR consent management. The front-end CMP (Consent Management Platform) uses this response to render the cookie banner. Response is cached for 1 hour (Cache-Control: public, max-age=3600). Anonymous — no authentication required.",
        "operationId": "GetCookieConsentConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CookieConsentConfigResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [{}]
      }
    },
    "/cookies/consent": {
      "post": {
        "tags": ["Cookie Consent"],
        "summary": "Records a cookie-consent decision in the server-side ledger.",
        "description": "Appends the user's consent decision (granted and denied categories) to the append-only consent ledger — the GDPR Art. 7(1) evidence that consent was given. Called by the front-end CMP after the user interacts with the cookie banner, before any authentication. The client IP is irreversibly anonymized and the user-agent truncated before storage; without a persistent ledger registered the decision is acknowledged but not recorded.",
        "operationId": "RecordCookieConsentDecision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentDecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [{}]
      }
    }
  },
  "components": {
    "schemas": {
      "ConsentDecisionRequest": {
        "required": ["cmpSource"],
        "type": "object",
        "properties": {
          "grantedCategories": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "deniedCategories": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CookieConsentMode"
              }
            ]
          },
          "cmpSource": {
            "maxLength": 64,
            "type": "string",
            "default": "cookieconsent"
          }
        },
        "example": {
          "grantedCategories": ["strictly_necessary", "preferences", "analytics"],
          "deniedCategories": ["marketing", "sale_or_sharing"],
          "mode": "OptIn",
          "cmpSource": "cookieconsent"
        }
      },
      "CookieConsentConfigResponse": {
        "required": ["cookies", "services"],
        "type": "object",
        "properties": {
          "cookies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CookieDefinitionResponse"
            }
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThirdPartyServiceResponse"
            }
          }
        },
        "example": {
          "cookies": [
            {
              "name": ".Granit.Session",
              "category": "strictly_necessary",
              "retentionDays": 1,
              "purpose": "Maintains the authenticated session."
            },
            {
              "name": ".Granit.Locale",
              "category": "preferences",
              "retentionDays": 365,
              "purpose": "Stores the user's preferred language."
            }
          ],
          "services": [
            {
              "name": "matomo",
              "category": "analytics",
              "cookiePatterns": ["^_pk_", "^mtm_"]
            }
          ]
        }
      },
      "CookieConsentMode": {
        "enum": ["OptIn", "OptOut", "Hybrid", "None", null]
      },
      "CookieDefinitionResponse": {
        "required": ["name", "category", "retentionDays", "purpose"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "retentionDays": {
            "type": "integer",
            "format": "int32"
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type."
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence."
          }
        }
      },
      "ThirdPartyServiceResponse": {
        "required": ["name", "category", "cookiePatterns"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "cookiePatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cookie Consent"
    }
  ]
}
