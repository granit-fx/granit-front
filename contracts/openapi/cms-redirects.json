                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["CMS - Redirects"],
        "summary": "Creates a redirect.",
        "description": "Creates a new redirect for the site from source to target. Returns 422 when the source would create a redirect loop or the source/target paths are invalid. The response includes an optional warning when the redirect source shadows a live page path.",
        "operationId": "CreateCmsRedirect",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "description": "Unique identifier of the site.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
