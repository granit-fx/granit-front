  "paths": {
    "/api/cms/redirects/resolve": {
      "get": {
        "tags": ["CMS - Redirects"],
        "summary": "Resolves a request path to its redirect target, or 204 when none matches.",
        "description": "Called by the renderer middleware on every incoming request to check for a redirect before rendering. Returns the target URL and HTTP status code when a matching active redirect is found; returns 204 when no redirect matches, indicating the request should proceed to page rendering.",
        "operationId": "ResolveCmsRedirect",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [{}]
      }
    },
    "/api/cms/redirects/sites/{siteId}/redirects": {
      "get": {
        "tags": ["CMS - Redirects"],
        "summary": "Lists a site's redirects.",
