{
  "name": "granit-front",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared TypeScript/React framework for Digital Dynamics front-end applications",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "lint": "eslint 'packages/@granit/*/src/**/*.{ts,tsx}' --max-warnings 0",
    "tsc": "pnpm -r exec -- tsc --noEmit",
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:csp": "node scripts/check-csp-policies.mjs",
    "format": "prettier --write \"packages/@granit/*/src/**/*.{ts,tsx}\"",
    "storybook": "storybook dev -p 6007",
    "storybook:build": "storybook build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@granit/ui-themes": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-document-load": "^0.66.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-themes": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "^1.18.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "keycloak-js": "^26.2.4",
    "lint-staged": "^17.2.0",
    "lucide-react": "^1.27.0",
    "markdownlint-cli2": "^0.23.2",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "storybook": "^10.5.4",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vanilla-cookieconsent": "3.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ],
    "*.{ts,tsx}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "engines": {
    "node": ">=24"
  }
}
