{
  "name": "granit-front",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared TypeScript/React framework for Digital Dynamics front-end applications",
  "type": "module",
  "scripts": {
    "lint": "eslint 'packages/@granit/*/src/**/*.{ts,tsx}' --max-warnings 0",
    "tsc": "pnpm -r exec -- tsc --noEmit",
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"packages/@granit/*/src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@date-fns/tz": "^1.4.1",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.6.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-document-load": "^0.59.0",
    "@opentelemetry/instrumentation-fetch": "^0.214.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-web": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-import-x": "^4.16.2",
    "husky": "^9.1.7",
    "i18next": "^26.0.4",
    "jsdom": "^29.0.2",
    "keycloak-js": "^26.2.3",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "msw": "^2.13.2",
    "prettier": "^3.8.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.5.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "msw",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "immutable": ">=5.1.5",
      "flatted": ">=3.4.2",
      "@tanstack/query-core": "^5.95.0",
      "picomatch": ">=4.0.4",
      "yaml": ">=2.8.3",
      "smol-toml": ">=1.6.1",
      "brace-expansion": ">=5.0.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,css,json}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ],
    "*.{ts,tsx}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "engines": {
    "node": ">=24"
  }
}
