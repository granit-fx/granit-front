{
  "name": "granit-front",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared TypeScript/React framework for Digital Dynamics front-end applications",
  "type": "module",
  "scripts": {
    "lint": "eslint 'packages/@granit/*/src/**/*.{ts,tsx}' --max-warnings 0",
    "tsc": "pnpm -r exec -- tsc --noEmit",
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:csp": "node scripts/check-csp-policies.mjs",
    "format": "prettier --write \"packages/@granit/*/src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-document-load": "^0.63.0",
    "@opentelemetry/instrumentation-fetch": "^0.218.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-virtual": "^3.14.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "axios": "1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "eslint": "^10.4.1",
    "eslint-plugin-import-x": "^4.16.2",
    "husky": "^9.1.7",
    "i18next": "^26.3.1",
    "jsdom": "^29.1.1",
    "keycloak-js": "^26.2.4",
    "lint-staged": "^17.0.7",
    "lucide-react": "^1.17.0",
    "markdownlint-cli2": "^0.22.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vanilla-cookieconsent": "3.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "msw",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "@tanstack/query-core": "^5.100.11",
      "@tanstack/react-query": "5.100.14",
      "axios": "1.16.1",
      "js-cookie": ">=3.0.7",
      "msw": "^2.14.6",
      "picomatch": ">=4.0.4",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,css,json}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ],
    "*.{ts,tsx}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "engines": {
    "node": ">=24"
  }
}
